# Template only — copy to server/.env and fill in real values there.
# This file IS committed (C-4, NFR-S4): never put a real secret in it.
PORT=8000

# Local:  mongodb://127.0.0.1:27017/procurement_platform
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>   (NFR-PO1)
MONGOOSE_URI=

SECRET=
CLIENT_ORIGIN=http://localhost:5173
ADMIN_EMAIL=
ADMIN_PASSWORD=
GEMINI_API_KEY=

# Optional: overrides the default Gemini model name
GEMINI_MODEL=

# Rate limiting (NFR-S, L-3). Leave blank for the production defaults:
# 300 requests / 15 min globally, 10 auth attempts / 15 min, 30 bids / min.
# A development machine running the test suites may raise these.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX=
BID_RATE_LIMIT_WINDOW_MS=
BID_RATE_LIMIT_MAX=
